                    <AlertTriangle className="w-6 h-6" />
                  </div>
                  <p className="text-xs font-medium text-slate-400 uppercase tracking-wider">Active Alerts</p>
                  <h3 className="text-3xl font-extrabold text-white mt-2">{stats.activeAlertsCount}</h3>
                  <div className="mt-4 flex items-center gap-1.5 text-xs text-slate-400">
                    <Clock className="w-3.5 h-3.5 text-slate-400" />
                    <span>Requires Dispatcher Action</span>
                  </div>
                </div>
              </div>

              {/* CHARTS SECTION */}
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                {/* Trend Chart (2 Cols) */}
                <div className="lg:col-span-2 bg-slate-900/90 border border-slate-800 p-6 rounded-2xl">
                  <div className="flex items-center justify-between mb-6">
