export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [isSimulating, setIsSimulating] = useState(true);
  const [personnel, setPersonnel] = useState(initialPersonnel);
  const [machines, setMachines] = useState(initialMachines);
  const [logs, setLogs] = useState(initialLogs);
  const [trendData, setTrendData] = useState(initialTrendData);

  // Modals state
  const [personnelModalOpen, setPersonnelModalOpen] = useState(false);
  const [editingPersonnel, setEditingPersonnel] = useState(null);
  const [machineModalOpen, setMachineModalOpen] = useState(false);
  const [editingMachine, setEditingMachine] = useState(null);

  // Filters state
  const [personnelSearch, setPersonnelSearch] = useState('');
  const [personnelStatusFilter, setPersonnelStatusFilter] = useState('All');
  const [personnelZoneFilter, setPersonnelZoneFilter] = useState('All');

  const [machineSearch, setMachineSearch] = useState('');
  const [machineStatusFilter, setMachineStatusFilter] = useState('All');

  const [logTypeFilter, setLogTypeFilter] = useState('All');

  // Notification Toast state
  const [toastMessage, setToastMessage] = useState(null);

  const showToast = (msg, type = 'info') => {
    setToastMessage({ msg, type });
    setTimeout(() => setToastMessage(null), 3500);
  };

  // Real-time Simulation Engine
  useEffect(() => {
    if (!isSimulating) return;

    const interval = setInterval(() => {
      // 1. Randomize machine temp & load slightly
      setMachines(prevMachines =>
        prevMachines.map(m => {
          if (m.status === 'Running') {
            const loadDelta = (Math.random() - 0.5) * 4;
            const tempDelta = (Math.random() - 0.5) * 1.5;
            const newLoad = Math.min(100, Math.max(10, Math.round(m.load + loadDelta)));
            const newTemp = Math.min(250, Math.max(20, parseFloat((m.temp + tempDelta).toFixed(1))));
            return { ...m, load: newLoad, temp: newTemp };
          }
          return m;
        })
      );

      // 2. Randomize working personnel Vitals
      setPersonnel(prevPersonnel =>
        prevPersonnel.map(p => {
          if (p.status === 'Working' || p.status === 'Hazard') {
            const hrDelta = Math.floor((Math.random() - 0.5) * 6);
            const newHr = Math.min(140, Math.max(60, p.heartRate + hrDelta));
            return { ...p, heartRate: newHr };
          }
          return p;
        })
      );

      // 3. Append to trend chart
      const now = new Date();
      const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
      
      setTrendData(prevTrend => {
        const running = machines.filter(m => m.status === 'Running');
        const avgLd = running.length ? Math.round(running.reduce((a, b) => a + b.load, 0) / running.length) : 0;
        const avgTp = running.length ? Math.round(running.reduce((a, b) => a + b.temp, 0) / running.length) : 0;
        const updated = [...prevTrend.slice(1), { time: timeStr, loadAvg: avgLd, avgTemp: avgTp }];
        return updated;
      });

    }, 3000);

    return () => clearInterval(interval);
  }, [isSimulating, machines]);

  // Derived KPI values
  const stats = useMemo(() => {
    const totalStaff = personnel.length;
    const activeStaff = personnel.filter(p => p.status === 'Working').length;
    const hazardStaff = personnel.filter(p => p.status === 'Hazard').length;

    const totalMac = machines.length;
    const runningMac = machines.filter(m => m.status === 'Running').length;
    const faultMac = machines.filter(m => m.status === 'Fault').length;
    const runningRate = totalMac > 0 ? ((runningMac / totalMac) * 100).toFixed(1) : '0';

    const activeAlertsCount = logs.filter(l => l.status === 'Active').length;

    return { totalStaff, activeStaff, hazardStaff, totalMac, runningMac, faultMac, runningRate, activeAlertsCount };
  }, [personnel, machines, logs]);

  // Pie chart data for Zone distribution
  const zoneDistribution = useMemo(() => {
    const counts = {};
    personnel.forEach(p => {
      counts[p.zone] = (counts[p.zone] || 0) + 1;
    });
    return Object.keys(counts).map(zone => ({ name: zone, value: counts[zone] }));
  }, [personnel]);

  const COLORS = ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];

  // --- CRUD FUNCTIONS FOR PERSONNEL ---
  const handleSavePersonnel = (data) => {
    if (editingPersonnel) {
      setPersonnel(prev => prev.map(p => p.id === editingPersonnel.id ? { ...p, ...data } : p));
      showToast(`Updated operator profile: ${data.name}`);
    } else {
      const newId = `EMP-${Math.floor(100 + Math.random() * 900)}`;
      setPersonnel(prev => [...prev, { ...data, id: newId, lastActive: 'Just now' }]);
      showToast(`Added new operator: ${data.name}`);
    }
    setPersonnelModalOpen(false);
    setEditingPersonnel(null);
  };

  const handleDeletePersonnel = (id) => {
    setPersonnel(prev => prev.filter(p => p.id !== id));
    showToast('Personnel removed successfully', 'warning');
  };

  // --- CRUD FUNCTIONS FOR MACHINES ---
  const handleSaveMachine = (data) => {
    if (editingMachine) {
      setMachines(prev => prev.map(m => m.id === editingMachine.id ? { ...m, ...data } : m));
      showToast(`Updated machinery settings for: ${data.name}`);
    } else {
      const newId = `MAC-${Math.floor(800 + Math.random() * 100)}`;
      setMachines(prev => [...prev, { ...data, id: newId, load: 0, temp: 25.0, powerState: false }]);
      showToast(`Registered new machine asset: ${data.name}`);
    }
    setMachineModalOpen(false);
    setEditingMachine(null);
  };

  const handleDeleteMachine = (id) => {
    setMachines(prev => prev.filter(m => m.id !== id));
    showToast('Machine asset removed', 'warning');
  };

  const handleTogglePower = (id) => {
    setMachines(prev => prev.map(m => {
      if (m.id === id) {
        const nextState = !m.powerState;
        const nextStatus = nextState ? 'Running' : 'Idle';
        showToast(`Machine ${m.name} power state toggled to ${nextState ? 'ON' : 'OFF'}`);
        return { ...m, powerState: nextState, status: nextStatus, load: nextState ? 50 : 0 };
      }
      return m;
    }));
  };

  const handleResolveLog = (id) => {
    setLogs(prev => prev.map(l => l.id === id ? { ...l, status: 'Resolved' } : l));
    showToast('Alert marked as resolved', 'info');
  };

  // Filtering Logic
  const filteredPersonnel = personnel.filter(p => {
    const matchesSearch = p.name.toLowerCase().includes(personnelSearch.toLowerCase()) || p.id.toLowerCase().includes(personnelSearch.toLowerCase());
    const matchesStatus = personnelStatusFilter === 'All' || p.status === personnelStatusFilter;
    const matchesZone = personnelZoneFilter === 'All' || p.zone === personnelZoneFilter;
    return matchesSearch && matchesStatus && matchesZone;
  });

  const filteredMachines = machines.filter(m => {
    const matchesSearch = m.name.toLowerCase().includes(machineSearch.toLowerCase()) || m.id.toLowerCase().includes(machineSearch.toLowerCase());
    const matchesStatus = machineStatusFilter === 'All' || m.status === machineStatusFilter;
    return matchesSearch && matchesStatus;
  });

  const filteredLogs = logs.filter(l => {
    if (logTypeFilter === 'All') return true;
    return l.type === logTypeFilter;
  });

  return (
    <div className="flex h-screen bg-slate-950 text-slate-100 font-sans overflow-hidden">

      {/* TOAST NOTIFICATION */}
