                      <h3 className="text-base font-bold text-white">Live Telemetry Trends</h3>
                      <p className="text-xs text-slate-400">Average Machine Load vs Temperature Over Time</p>
                    </div>
                    <span className="flex items-center gap-1 text-xs text-cyan-400 bg-cyan-950/60 border border-cyan-800 px-2.5 py-1 rounded-full">
