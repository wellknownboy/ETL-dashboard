              <div className="flex items-center gap-3">
                <Cpu className="w-5 h-5" />
                Equipment Monitor
              </div>
              {stats.faultMac > 0 && (
                <span className="bg-amber-500/20 text-amber-400 text-xs px-2 py-0.5 rounded-full border border-amber-500/30 font-mono">
                  {stats.faultMac}
                </span>
