                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Current Status</label>
                  <select
                    name="status"
                    defaultValue={editingPersonnel?.status || 'Working'}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  >
                    <option value="Working">Working</option>
                    <option value="On Break">On Break</option>
                    <option value="Hazard">Hazard</option>
                    <option value="Offline">Offline</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-400 mb-1">Heart Rate (BPM)</label>
                  <input
                    type="number"
                    name="heartRate"
                    defaultValue={editingPersonnel?.heartRate || 75}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Body Temp (°C)</label>
                  <input
                    type="number"
                    step="0.1"
                    name="bodyTemp"
                    defaultValue={editingPersonnel?.bodyTemp || 36.5}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>
              </div>

              <div className="pt-4 flex justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setPersonnelModalOpen(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl font-medium"
                >
                  Save Profile
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ==================== MODAL: ADD / EDIT MACHINE ==================== */}
      {machineModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 space-y-6 shadow-2xl">
            <div className="flex items-center justify-between border-b border-slate-800 pb-4">
              <h3 className="text-lg font-bold text-white">
                {editingMachine ? 'Edit Equipment Specs' : 'Register New Machine Asset'}
              </h3>
              <button 
                onClick={() => setMachineModalOpen(false)}
                className="text-slate-400 hover:text-white p-1 rounded-lg"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form
              onSubmit={(e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                handleSaveMachine({
                  name: formData.get('name'),
                  type: formData.get('type'),
                  zone: formData.get('zone'),
                  status: formData.get('status'),
                  lastMaintenance: formData.get('lastMaintenance'),
                });
              }}
              className="space-y-4 text-sm"
            >
              <div>
                <label className="block text-slate-400 mb-1">Equipment Name</label>
                <input
                  name="name"
                  defaultValue={editingMachine?.name || ''}
                  required
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                />
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-400 mb-1">Machine Type</label>
                  <input
                    name="type"
                    defaultValue={editingMachine?.type || 'Heavy Duty'}
                    required
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Assigned Zone</label>
                  <select
                    name="zone"
                    defaultValue={editingMachine?.zone || 'Zone A - Assembly'}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  >
                    <option value="Zone A - Assembly">Zone A - Assembly</option>
                    <option value="Zone B - Chemical Processing">Zone B - Chemical</option>
                    <option value="Zone C - Machining">Zone C - Machining</option>
                    <option value="Warehouse 1">Warehouse 1</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-400 mb-1">Operating Status</label>
                  <select
                    name="status"
                    defaultValue={editingMachine?.status || 'Idle'}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  >
                    <option value="Running">Running</option>
                    <option value="Idle">Idle</option>
                    <option value="Fault">Fault</option>
                    <option value="Maintenance">Maintenance</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-400 mb-1">Last Maintenance Date</label>
                  <input
                    type="date"
                    name="lastMaintenance"
                    defaultValue={editingMachine?.lastMaintenance || new Date().toISOString().split('T')[0]}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500"
                  />
                </div>
              </div>

              <div className="pt-4 flex justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setMachineModalOpen(false)}
                  className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl font-medium"
                >
                  Save Equipment
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
