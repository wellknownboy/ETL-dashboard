        <div className={`fixed top-5 right-5 z-50 flex items-center gap-3 px-4 py-3 rounded-xl shadow-2xl border backdrop-blur-md transition-all duration-300 animate-bounce ${
          toastMessage.type === 'warning' ? 'bg-amber-950/80 border-amber-500/50 text-amber-200' :
          toastMessage.type === 'error' ? 'bg-rose-950/80 border-rose-500/50 text-rose-200' :
          'bg-cyan-950/80 border-cyan-500/50 text-cyan-200'
        }`}>
          <Zap className="w-5 h-5 text-current animate-pulse" />
          <span className="text-sm font-medium">{toastMessage.msg}</span>
        </div>
      )}

      {/* LEFT NAVIGATION BAR */}
      <aside className="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between select-none">
        <div>
          {/* Logo & Header */}
          <div className="p-6 border-b border-slate-800 flex items-center gap-3">
            <div className="p-2.5 bg-gradient-to-tr from-cyan-600 to-blue-600 rounded-xl shadow-lg shadow-cyan-500/20">
              <Activity className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="font-bold text-lg leading-tight tracking-wide text-white">VanguardOps</h1>
              <p className="text-xs text-slate-4-00 font-mono tracking-wider text-cyan-400">STATUS MONITOR v2.4</p>
            </div>
          </div>

          {/* Navigation Links */}
          <nav className="p-4 space-y-1">
            <button
              onClick={() => setActiveTab('dashboard')}
              className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${
                activeTab === 'dashboard'
                  ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 shadow-sm shadow-cyan-500/10'
                  : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'
              }`}
            >
              <LayoutDashboard className="w-5 h-5" />
              Overview Dashboard
            </button>

            <button
              onClick={() => setActiveTab('personnel')}
              className={`w-full flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium transition-all ${
                activeTab === 'personnel'
                  ? 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 shadow-sm shadow-cyan-500/10'
                  : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'
