            >
              <div className="flex items-center gap-3">
                <Bell className="w-5 h-5" />
                Alerts & Audit Logs
              </div>
              {stats.activeAlertsCount > 0 && (
                <span className="bg-rose-500 text-slate-950 font-bold text-xs px-2 py-0.5 rounded-full animate-pulse">
                  {stats.activeAlertsCount}
                </span>
              )}
            </button>
          </nav>
        </div>

        {/* Live Controls & Footer Info */}
        <div className="p-4 border-t border-slate-800 space-y-3">
          <div className="bg-slate-950/70 p-3 rounded-xl border border-slate-800/80 flex items-center justify-between">
            <div className="flex items-center gap-2">
              <div className={`w-2.5 h-2.5 rounded-full ${isSimulating ? 'bg-emerald-500 animate-ping' : 'bg-slate-500'}`} />
              <span className="text-xs text-slate-300 font-medium">
                {isSimulating ? 'Telemetry Live' : 'Feed Paused'}
              </span>
            </div>
            <button
              onClick={() => setIsSimulating(!isSimulating)}
              className="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition-colors"
              title={isSimulating ? 'Pause Telemetry' : 'Resume Telemetry'}
            >
              {isSimulating ? <Pause className="w-4 h-4" /> : <Play className="w-4 h-4" />}
            </button>
          </div>

          <div className="flex items-center justify-between px-2 text-xs text-slate-500">
            <span>System Status: <span className="text-emerald-400">Normal</span></span>
            <span>Server: AP-EAST-1</span>
          </div>
        </div>
      </aside>

      {/* MAIN CONTENT AREA */}
      <main className="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-950">
        
        {/* TOP HEADER */}
        <header className="sticky top-0 z-10 bg-slate-900/80 backdrop-blur-md border-b border-slate-800 px-8 py-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <h2 className="text-xl font-bold text-white capitalize">
              {activeTab === 'dashboard' && 'Operations Center Dashboard'}
              {activeTab === 'personnel' && 'Personnel Management & Telemetry'}
              {activeTab === 'machines' && 'Equipment & Asset Telemetry'}
              {activeTab === 'logs' && 'System Event Logs & Notifications'}
            </h2>
          </div>

          <div className="flex items-center gap-4">
            <span className="text-xs font-mono bg-slate-800 text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700">
              System Time: {new Date().toLocaleTimeString()}
            </span>
            {activeTab === 'personnel' && (
              <button
                onClick={() => { setEditingPersonnel(null); setPersonnelModalOpen(true); }}
                className="flex items-center gap-2 px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-sm font-medium transition-all shadow-lg shadow-cyan-600/20"
              >
                <Plus className="w-4 h-4" /> Add Personnel
              </button>
            )}
            {activeTab === 'machines' && (
              <button
                onClick={() => { setEditingMachine(null); setMachineModalOpen(true); }}
                className="flex items-center gap-2 px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-sm font-medium transition-all shadow-lg shadow-cyan-600/20"
              >
                <Plus className="w-4 h-4" /> Add Equipment
              </button>
            )}
          </div>
        </header>

        {/* TAB CONTENTS */}
        <div className="p-8 space-y-8">

          {/* ==================== TAB 1: OVERVIEW DASHBOARD ==================== */}
          {activeTab === 'dashboard' && (
            <>
              {/* KPI Summary Cards */}
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                
                {/* Total Personnel */}
                <div className="bg-slate-900/90 border border-slate-800 p-6 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all">
                  <div className="absolute right-4 top-4 p-3 bg-blue-500/10 text-blue-400 rounded-xl">
                    <Users className="w-6 h-6" />
                  </div>
                  <p className="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Personnel</p>
                  <h3 className="text-3xl font-extrabold text-white mt-2">{stats.totalStaff}</h3>
                  <div className="mt-4 flex items-center gap-2 text-xs">
                    <span className="text-emerald-400 font-semibold">{stats.activeStaff} Active</span>
                    <span className="text-slate-500">•</span>
                    <span className="text-amber-400 font-semibold">{stats.hazardStaff} Hazard Alert</span>
                  </div>
                </div>

                {/* Machine Fleet */}
                <div className="bg-slate-900/90 border border-slate-800 p-6 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all">
                  <div className="absolute right-4 top-4 p-3 bg-cyan-500/10 text-cyan-400 rounded-xl">
                    <Cpu className="w-6 h-6" />
                  </div>
                  <p className="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Machinery</p>
                  <h3 className="text-3xl font-extrabold text-white mt-2">{stats.totalMac}</h3>
                  <div className="mt-4 flex items-center gap-2 text-xs">
                    <span className="text-emerald-400 font-semibold">{stats.runningMac} Running</span>
                    <span className="text-slate-500">•</span>
                    <span className="text-rose-400 font-semibold">{stats.faultMac} Faults</span>
                  </div>
                </div>

                {/* Fleet Running Rate */}
                <div className="bg-slate-900/90 border border-slate-800 p-6 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all">
                  <div className="absolute right-4 top-4 p-3 bg-emerald-500/10 text-emerald-400 rounded-xl">
                    <Activity className="w-6 h-6" />
                  </div>
                  <p className="text-xs font-medium text-slate-400 uppercase tracking-wider">Fleet Operational Rate</p>
                  <h3 className="text-3xl font-extrabold text-white mt-2">{stats.runningRate}%</h3>
                  <div className="w-full bg-slate-800 h-2 rounded-full mt-4 overflow-hidden">
                    <div 
                      className="bg-emerald-500 h-full transition-all duration-500" 
                      style={{ width: `${stats.runningRate}%` }}
                    />
                  </div>
                </div>

                {/* Active System Alerts */}
